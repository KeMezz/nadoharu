{
  "name": "@nadoharu/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "graphql:codegen": "graphql-codegen --config codegen.ts",
    "graphql:generate": "pnpm --filter api graphql:schema && pnpm graphql:codegen",
