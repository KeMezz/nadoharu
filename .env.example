# Database Configuration
DATABASE_URL="postgresql://nadoharu:nadoharu_dev@localhost:5432/nadoharu"

# Application Configuration
NODE_ENV="development"
PORT=3001
# CORS_ORIGIN is used in production to restrict allowed origins
# CORS_ORIGIN="https://yourdomain.com"
# TRUST_PROXY_HOPS controls trusted proxy hop count for request.ip resolution
# Set this in any environment behind a reverse proxy (staging/production)
# TRUST_PROXY_HOPS=1

# JWT Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_THIS_TO_RANDOM_SECRET_IN_PRODUCTION"
# Supported units: ms, s, m, h, d (default: 15m)
JWT_EXPIRES_IN="15m"

# Cloudflare R2 Configuration (S3 Compatible)
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="nadoharu-media"
R2_PUBLIC_URL="https://your-custom-domain.com"

# Web (Next.js) server proxy configuration
# GRAPHQL_UPSTREAM_URL="http://localhost:3001/graphql"
